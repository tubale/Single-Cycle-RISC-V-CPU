// RV32I CPU Waveform Demo

// Register setup
00A00093    // addi x1, x0, 10      -> x1 = 10
00400113    // addi x2, x0, 4       -> x2 = 4

// R-Type ALU
002081B3    // add  x3, x1, x2      -> x3 = 14
40208233    // sub  x4, x1, x2      -> x4 = 6
0020F2B3    // and  x5, x1, x2      -> x5 = 0
0020E333    // or   x6, x1, x2      -> x6 = 14
0020C3B3    // xor  x7, x1, x2      -> x7 = 14
00112433    // slt  x8, x2, x1      -> x8 = 1

// I-Type ALU
00508493    // addi x9, x1, 5       -> x9 = 15
0060F513    // andi x10, x1, 6      -> x10 = 2
00816593    // ori  x11, x2, 8      -> x11 = 12
0030C613    // xori x12, x1, 3      -> x12 = 9
00A12693    // slti x13, x2, 10     -> x13 = 1

// Memory
00302023    // sw x3, 0(x0)         -> memory[0] = 14
00002703    // lw x14, 0(x0)        -> x14 = 14

// BEQ - branch should be taken
00E18463    // beq x3, x14, +8      -> skip next instruction
06300793    // addi x15, x0, 99     -> should be skipped
00100793    // addi x15, x0, 1      -> x15 = 1

// BNE - branch should be taken
00209463    // bne x1, x2, +8       -> skip next instruction
06300813    // addi x16, x0, 99     -> should be skipped
00200813    // addi x16, x0, 2      -> x16 = 2

// JAL
008008EF    // jal x17, +8           -> jump + save PC+4 in x17
06300913    // addi x18, x0, 99     -> should be skipped
00300913    // addi x18, x0, 3      -> x18 = 3

// Done
0000006F    // jal x0, 0             -> infinite loop